# Tag d'image immuable déployé en staging (ex: v1.0.0 — jamais latest)
IMAGE_TAG=v1.0.0

# Port hôte exposé par le proxy staging (vérifié libre localement ; éviter 8080/8081 si occupés)
# CORS_ALLOWED_ORIGINS du backend est dérivé automatiquement dans compose.staging.yaml.
STAGING_PORT=8089

# Paramètres PostgreSQL internes du staging (service db non exposé à l'hôte)
POSTGRES_DB=eventflow_staging
POSTGRES_USER=eventflow_staging_user
POSTGRES_PASSWORD=replace-with-staging-db-password

# Connexion backend vers le service db interne (jamais localhost dans un conteneur)
DB_URL=jdbc:postgresql://db:5432/eventflow_staging
DB_USERNAME=eventflow_staging_user
DB_PASSWORD=replace-with-staging-db-password

# Secret JWT Base64 (minimum 32 octets ; ex: openssl rand -base64 48)
JWT_SECRET=replace-with-staging-base64-encoded-secret-min-32-bytes

# Clés factices du module de paiement simulé
PAYMENT_API_KEY=replace-with-staging-payment-api-key
PAYMENT_SECRET_KEY=replace-with-staging-payment-secret-key

# Compte administrateur initial du staging (mot de passe 12 à 72 octets)
ADMIN_EMAIL=admin.staging@example.com
ADMIN_PASSWORD=replace-with-staging-admin-password-min-12-chars
