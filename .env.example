# Nom de la base PostgreSQL interne au réseau Compose
POSTGRES_DB=eventflow

# URL JDBC vers le service Compose "db" (ne jamais utiliser localhost dans un conteneur)
DB_URL=jdbc:postgresql://db:5432/eventflow

# Nom d'utilisateur PostgreSQL
DB_USERNAME=eventflow_user

# Mot de passe PostgreSQL (remplacer par une valeur locale non versionnée)
DB_PASSWORD=replace-with-local-db-password

# Clé secrète JWT en Base64 (minimum 32 octets ; ex: openssl rand -base64 48)
JWT_SECRET=replace-with-base64-encoded-secret-min-32-bytes

# Port hôte exposé par le reverse proxy Nginx (changer si 8080 est occupé sur l'hôte)
# L'origine CORS du backend (http://localhost:<PROXY_PORT>) est dérivée automatiquement dans compose.yaml.
PROXY_PORT=8080

# Clés factices du module de paiement simulé (requises par le profil Spring prod)
PAYMENT_API_KEY=replace-with-simulated-payment-api-key
PAYMENT_SECRET_KEY=replace-with-simulated-payment-secret-key

# Compte administrateur initial créé par BootstrapAdminRunner (mot de passe 12 à 72 octets)
ADMIN_EMAIL=admin.eventflow@example.com
ADMIN_PASSWORD=replace-with-admin-password-min-12-chars
